            {
                "plugin": "tempairport",
                "enable": true,
                "task": {
                    "rename": "⏳ {name}",
                    "push_to": [
                        "free"
                    ]
                }
            },
            {
                "plugin": "dynamic",
                "enable": true,
                "task": {
                    "rename": "🛰️ {name}",
                    "push_to": [
                        "free"
                    ]
