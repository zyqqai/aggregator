{
    "sites": [],
    "crawl": {
        "enable": true,
        "exclude": "",
        "max_fails": 5,
        "include_nodes": true,
        "persist": {
            "subscribe": "crawledsubs",
            "nodes": "crawledproxies"
        },
        "task": {
            "rename": "🌀 {name}",
            "check_alive": true,
            "max_rate": 3.0
        },
        "telegram": {
            "enable": false,
            "pages": 3,
            "exclude": "",
            "channels": {}
        },
        "github": {
            "enable": true,
            "pages": 2,
            "push_to": [
                "free"
            ],
            "exclude": "(?i)(test|demo|example|template|awesome|docs?)",
            "exclude_repos": []
        },
        "pages": [
            {
                "enable": true,
                "url": [
                    "https://raw.githubusercontent.com/freefq/free/master/v2",
